# Vorlage für die Konfiguration. Kopieren mit:  copy .env.example .env

# --- MQTT-Broker ---
# Python direkt auf dem PC: localhost | Python im Docker-Container: mqtt-broker
MQTT_HOST=localhost
MQTT_PORT=1883
# Sekunden ohne Lebenszeichen, bis der Broker den Client als ausgefallen ansieht
# (Last Will wird nach ca. 1,5 x Keepalive verschickt)
MQTT_KEEPALIVE=5

# --- Sendeintervalle in Sekunden je Funkprotokoll ---
INTERVAL_ZIGBEE=5
INTERVAL_BLE=30
# LoRaWAN sendet selten (Energiesparen, 1 % Duty Cycle im EU868-Band)
INTERVAL_LORAWAN=60

# --- Schwellwerte für die Automatisierung ---
# Klimaanlage EIN, wenn der Serverraum wärmer ist (°C)
SERVERROOM_TEMP_MAX=28
# Bewässerung EIN, wenn der Boden trockener ist (%)
SOIL_MOISTURE_MIN=30
